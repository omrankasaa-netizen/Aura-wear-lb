{
  "name": "Discount",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "name_ar": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed_amount",
        "fixed_price"
      ],
      "default": "percentage"
    },
    "value": {
      "type": "number"
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "all_products",
        "category",
        "collection",
        "specific_products",
        "tag"
      ],
      "default": "all_products"
    },
    "target": {
      "type": "string",
      "description": "Category ID / Collection ID / product IDs (comma-sep) / tag name based on applies_to"
    },
    "sizes": {
      "type": "string",
      "description": "Optional comma-separated sizes this discount applies to (e.g. XL,XXL). Empty = all sizes. Size-scoped discounts apply only once a size is chosen (PDP selection, cart, checkout, manual orders); product cards and grids keep showing the real base price so a sale on XL never makes every size look discounted."
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "badge_label": {
      "type": "string",
      "description": "e.g. SALE or -20%"
    },
    "badge_label_ar": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type",
    "value",
    "applies_to"
  ]
}
